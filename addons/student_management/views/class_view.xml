<odoo>
	<record model='ir.ui.view' id='class_search_view'>
		<field name='name'>class.search</field>
		<field name='model'>sm.class</field>
		<field name="priority" eval="16" />
		<field name="arch" type="xml">
			<search>
				<field name='name' />
				<field name='subject' />
			</search>

		</field>
	</record>

	<record model='ir.ui.view' id='class_list_view'>
		<field name='name'>class.list</field>
		<field name='model'>sm.class</field>
		<field name="priority" eval="16" />
		<field name="arch" type="xml">
			<tree>
				<field name='name' />
				<field name='teacher_id' />
				<field name='subject' />
				<field name='fee' />


				<field name="status" />





			</tree>

		</field>
	</record>
	<record model='ir.ui.view' id='class_form_view'>
		<field name='name'>class.form</field>
		<field name='model'>sm.class</field>
		<field name="priority" eval="16" />
		<field name="arch" type="xml">
			<form>
				<group col="4">
					<h2 colspan="2">
						<field placeholder="Class name" name='name' />
					</h2>
					<group colspan="2">

						<field style='color: green;' name='status'
							attrs="{'invisible':[('status', '!=', 'ig')]}" />
						<field style='color: red;' name='status'
							attrs="{'invisible':[('status', '=', 'ig')]}" />

					</group>


					<group colspan='2'>
						<field name='teacher_id' />
						<field name='subject' />
						<field name='seat' />
						<field name='empty_seat' />
					</group>

					<group colspan='2'>
						<field name='currency_id' />
						<field style='text-decoration:line-through;'
							name='original_price' />
						<field name='discount' />
						<field style='color:green;' name='fee' />
					</group>

					<group colspan='2'>
						<field name='start_date' />
						<field name='end_date' />
					</group>

					<group colspan='2'>
						<h6>Advance</h6>
						<br />
						<hr style='height: 3px;' />
						<br />
						<group>
							<button class="btn btn-secondary" string='Update discount'
								name='open_update_discount_wizard' type='object' />
							<button class="btn btn-info"
								string='Create classes' name='open_create_multi_class_wizard'
								type='object' />
						</group>


					</group>

					<notebook colspan="4">
						<page string="Students">
							<field name='student_ids' />
						</page>
					</notebook>
				</group>
			</form>
		</field>
	</record>


</odoo>